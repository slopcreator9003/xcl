diff --git a/libs/vkd3d/vkd3d_private.h b/libs/vkd3d/vkd3d_private.h
index 8024485..49205c7 100644
--- a/libs/vkd3d/vkd3d_private.h
+++ b/libs/vkd3d/vkd3d_private.h
@@ -51,6 +51,34 @@
 
 #define VK_CALL(f) (vk_procs->f)
 
+/* XCL (https://github.com/ivall/xcl) replaces the vtable pointer of the D3D12 objects it hands to
+ * Xbox titles with its own vtable: a copy outside this module whose word before slot 0 is the
+ * original vtable. Such an object is still ours, with the type of that original vtable. Vtables
+ * inside this module are compared as they are, so our own objects are classified as before. */
+static inline bool vkd3d_vtbl_is(const void *vtbl, const void *expected)
+{
+#ifdef _WIN32
+    extern IMAGE_DOS_HEADER __ImageBase;
+    const IMAGE_NT_HEADERS *nt;
+    uintptr_t base, v;
+#endif
+
+    if (vtbl == expected)
+        return true;
+#ifdef _WIN32
+    base = (uintptr_t)&__ImageBase;
+    nt = (const IMAGE_NT_HEADERS *)(base + __ImageBase.e_lfanew);
+    v = (uintptr_t)vtbl;
+    if (!vtbl || (v >= base && v - base < nt->OptionalHeader.SizeOfImage))
+        return false;
+    return ((const void * const *)vtbl)[-1] == expected;
+#else
+    return false;
+#endif
+}
+
+#define VKD3D_VTBL_IS(iface, vtbl) vkd3d_vtbl_is((const void *)(iface)->lpVtbl, (const void *)(vtbl))
+
 #define MAKE_MAGIC(a,b,c,d) (((uint32_t)a) | (((uint32_t)b) << 8) | (((uint32_t)c) << 16) | (((uint32_t)d) << 24))
 
 #define VKD3D_MAX_COMPATIBLE_FORMAT_COUNT 10u
